        }
        return true;
    }

    const styled = ensureStyle();
    const placed = relocate();

    if (!window._malusControlsInstalled) {
        window._malusControlsInstalled = true;

        let observedTitlebar = null;
        let titlebarObserver = null;

        const attachObserver = () => {
            const titlebar = document.querySelector('.part.titlebar');
            if (!titlebar) {
                return false;
            }
            if (observedTitlebar !== titlebar) {
                if (titlebarObserver) {
                    titlebarObserver.disconnect();
                }
                observedTitlebar = titlebar;
                titlebarObserver = new MutationObserver(() => {
                    ensureStyle();
                    relocate();
                });
                // Observar la barra de título completa (incluyendo .titlebar-left/.titlebar-right),
                // manteniendo fuera editor Monaco, terminal y panel de chat IA.
                titlebarObserver.observe(titlebar, { childList: true, subtree: true });
            }
            ensureStyle();
            return relocate();
        };

        // Durante el arranque en frío de la sesión puede tardar varios segundos en montar el workbench.
        let attempts = 0;
        const initInterval = setInterval(() => {
            const ok = attachObserver();
            if ((ok && observedTitlebar) || ++attempts > 300) {
                clearInterval(initInterval);
            }
        }, 200);

        // Salvaguarda periódica ligera por si la barra de título se reemplaza tras iniciar sesión.
        setInterval(() => {
            if (!observedTitlebar || !observedTitlebar.isConnected) {
                attachObserver();
            } else {
                ensureStyle();
                relocate();
            }
        }, 1500);
    }

    return Boolean(styled && placed);
})()
"""

REINJECT_INTERVAL = 3.0  # segundos; el script inyectado es idempotente

def watcher(port, stop_event, state):
    # tid -> timestamp de la última confirmación exitosa. Reintenta rápido (0.5s)
    # durante el arranque en frío hasta confirmar montaje, y luego verifica cada
    # 3s para sobrevivir a "Reload Window" o recreaciones de DOM manteniendo el tid.
    injected_targets = {}
    url = f"http://127.0.0.1:{port}/json"

    while not stop_event.is_set():
        try:
            with urllib.request.urlopen(url, timeout=1) as resp:
                targets = json.loads(resp.read().decode('utf-8'))
                state["last_alive"] = time.time()
                state["ever_alive"] = True
                now = time.time()
                for t in targets:
                    tid = t.get("id")
                    t_url = t.get("url", "")
                    if t.get("type") != "page" or "workbench" not in t_url:
                        continue
                    last_ok = injected_targets.get(tid, 0.0)
                    if last_ok > 0.0 and (now - last_ok) < REINJECT_INTERVAL:
                        continue
                    ws_url = t.get("webSocketDebuggerUrl")
                    if ws_url and send_cdp_eval(ws_url, INJECTION_SCRIPT):
                        injected_targets[tid] = now
        except Exception:
            pass
        time.sleep(0.5)

def main():
    target_cmd = find_target_command(sys.argv[0], sys.argv[1:])
    port = get_free_port()
    args = target_cmd + [f"--remote-debugging-port={port}", "--ozone-platform-hint=auto"] + sys.argv[1:]

    proc = subprocess.Popen(args)

    stop_event = threading.Event()
    state = {"last_alive": 0.0, "ever_alive": False}
    t = threading.Thread(target=watcher, args=(port, stop_event, state), daemon=True)
    t.start()

    def handle_signal(sig, frame):
        try:
            proc.send_signal(sig)
        except Exception:
            pass

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    try:
        ret = proc.wait()
        # Si el proceso lanzado era un CLI que desacopla la ventana real (o si
        # Electron se relanzó a sí mismo), el IDE sigue vivo con nuestro puerto
        # de depuración: seguir inyectando mientras responda.
        start = time.time()
        while True:
            time.sleep(1)
            if state["ever_alive"]:
                if time.time() - state["last_alive"] > 5:
                    break
            elif time.time() - start > 30:
                # Nunca respondió (p. ej. ya había una instancia abierta que
                # absorbió la petición): no hay nada que vigilar.
                break
    finally:
        stop_event.set()

    sys.exit(ret)

if __name__ == "__main__":
    main()
