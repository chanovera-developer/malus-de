#!/usr/bin/env python3
"""
Malus DE - Universal Electron IDE Wrapper (Antigravity IDE & Visual Studio Code)
Injects left-aligned macOS style traffic light window controls at runtime
without modifying application files or triggering integrity warnings.
"""

import sys
import os
import shutil
import subprocess
import time
import socket
import urllib.request
import urllib.parse
import json
import base64
import threading
import signal

def is_same_file(path1, path2):
    try:
        return os.path.realpath(path1) == os.path.realpath(path2)
    except Exception:
        return False

def find_target_command(invoked_name, extra_args):
    self_path = os.path.realpath(__file__)

    # 1. Override explícito por variable de entorno (pasado por Spotlight, Dock o Branches
    # con el ejecutable exacto que el usuario seleccionó: ej. 'antigravity' vs 'antigravity-ide')
    explicit_bin = os.environ.get("MALUS_IDE_BIN", "").strip()
    if explicit_bin:
        base_explicit = os.path.basename(explicit_bin).lower()
        # Si ya es una ruta absoluta válida (y no apunta a este mismo wrapper), respetarla tal cual
        if os.path.isabs(explicit_bin) and os.path.isfile(explicit_bin) and os.access(explicit_bin, os.X_OK) and not is_same_file(explicit_bin, self_path):
            # Si apunta a un script CLI bin/* (p. ej. /usr/share/antigravity/bin/antigravity),
            # preferir el binario Electron hermano para mantener vivo el puerto CDP
            parent_dir = os.path.dirname(explicit_bin)
            if os.path.basename(parent_dir) == "bin":
                sibling_electron = os.path.join(os.path.dirname(parent_dir), os.path.basename(explicit_bin))
                if os.path.isfile(sibling_electron) and os.access(sibling_electron, os.X_OK):
                    return [sibling_electron]
            return [explicit_bin]

        # Si es un nombre corto ('antigravity' vs 'antigravity-ide'), resolver su binario real sin mezclarlos
        if base_explicit == "antigravity":
            for cand in [
                "/usr/share/antigravity/antigravity",
                "/opt/antigravity/antigravity",
                "/usr/local/share/antigravity/antigravity",
                os.path.expanduser("~/.local/share/antigravity/antigravity"),
            ]:
                if os.path.isfile(cand) and os.access(cand, os.X_OK) and not is_same_file(cand, self_path):
                    return [cand]
            w = shutil.which("antigravity")
            if w and not is_same_file(w, self_path):
                return [w]
            return [explicit_bin]
        elif base_explicit == "antigravity-ide":
            for cand in [
                os.path.expanduser("~/.local/share/antigravity-ide/antigravity-ide"),
                "/usr/local/share/antigravity-ide/antigravity-ide",
                "/opt/antigravity-ide/antigravity-ide",
                os.path.expanduser("~/.local/share/antigravity-ide/bin/antigravity-ide"),
            ]:
                if os.path.isfile(cand) and os.access(cand, os.X_OK) and not is_same_file(cand, self_path):
                    return [cand]
            w = shutil.which("antigravity-ide")
            if w and not is_same_file(w, self_path):
                return [w]
            return [explicit_bin]
        else:
            w = shutil.which(explicit_bin)
            if w and not is_same_file(w, self_path):
                return [w]
            return [explicit_bin]

    invoked_base = os.path.basename(invoked_name).lower()
    target_kind = os.environ.get("MALUS_IDE_TARGET", "").lower()

    if not target_kind:
        if any(k in invoked_base for k in ["code", "codium", "oss"]):
            target_kind = "vscode"
        elif "antigravity-ide" in invoked_base:
            target_kind = "antigravity-ide"
        elif "antigravity" in invoked_base:
            target_kind = "antigravity"

    # 2. Búsqueda para Visual Studio Code / Code - OSS / VSCodium
    if target_kind == "vscode":
        if "MALUS_VSCODE_BIN" in os.environ:
            return [os.environ["MALUS_VSCODE_BIN"]]

        # Preferir el binario Electron real: los scripts bin/* lanzan el CLI
        # (ELECTRON_RUN_AS_NODE), que crea la ventana desacoplada y termina
        # de inmediato, matando al watcher antes de inyectar los estilos.
        candidates = [
            "/usr/share/code/code",
            "/usr/share/code/bin/code",
            "/usr/bin/code",
            "/usr/local/bin/code",
            "/usr/bin/code-oss",
            "/usr/bin/codium",
            os.path.expanduser("~/.local/share/code/bin/code"),
        ]
        for candidate in candidates:
            if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and not is_same_file(candidate, self_path):
                return [candidate]

        for name in ["code", "code-oss", "codium"]:
            w = shutil.which(name)
            if w and not is_same_file(w, self_path):
                return [w]

        # Soporte para instalación Flatpak
        flatpak_bin = shutil.which("flatpak")
        if flatpak_bin:
            for app_id in ["com.visualstudio.code", "com.vscodium.codium"]:
                try:
                    res = subprocess.run([flatpak_bin, "info", app_id], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    if res.returncode == 0:
                        return [flatpak_bin, "run", app_id]
                except Exception:
                    pass

        return ["code"]

    # 3. Búsqueda para Antigravity / Antigravity IDE (respetando cuál fue invocado)
    if "MALUS_ANTIGRAVITY_BIN" in os.environ:
        return [os.environ["MALUS_ANTIGRAVITY_BIN"]]

    if target_kind == "antigravity":
        antigravity_candidates = [
            "/usr/share/antigravity/antigravity",
            "/opt/antigravity/antigravity",
            "/usr/local/share/antigravity/antigravity",
            os.path.expanduser("~/.local/share/antigravity/antigravity"),
            os.path.expanduser("~/.local/share/antigravity-ide/antigravity-ide"),
            "/usr/local/share/antigravity-ide/antigravity-ide",
            "/opt/antigravity-ide/antigravity-ide",
        ]
    else:
        antigravity_candidates = [
            os.path.expanduser("~/.local/share/antigravity-ide/antigravity-ide"),
            "/usr/local/share/antigravity-ide/antigravity-ide",
            "/opt/antigravity-ide/antigravity-ide",
            os.path.expanduser("~/.local/share/antigravity-ide/bin/antigravity-ide"),
            "/usr/share/antigravity/antigravity",
        ]
    for candidate in antigravity_candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) and not is_same_file(candidate, self_path):
            return [candidate]

    for bin_name in (["antigravity", "antigravity-ide"] if target_kind == "antigravity" else ["antigravity-ide", "antigravity"]):
        which_ag = shutil.which(bin_name)
        if which_ag and not is_same_file(which_ag, self_path):
            return [which_ag]

    # Si no se especificó un tipo y Antigravity no existe, probar con Code
    if not target_kind:
        for name in ["code", "code-oss", "codium"]:
            w = shutil.which(name)
            if w and not is_same_file(w, self_path):
                return [w]

    return ["antigravity" if target_kind == "antigravity" else "antigravity-ide"]

def get_free_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(('127.0.0.1', 0))
        return s.getsockname()[1]

def recv_exact(sock, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf.extend(chunk)
    return bytes(buf)

MAX_WS_FRAME_BYTES = 1024 * 1024
MAX_CDP_JSON_BYTES = 512 * 1024

def read_ws_text_frame(sock):
    header = recv_exact(sock, 2)
    if not header:
        return None
    length = header[1] & 0x7F
    if length == 126:
        ext = recv_exact(sock, 2)
        if not ext:
            return None
        length = int.from_bytes(ext, 'big')
    elif length == 127:
        ext = recv_exact(sock, 8)
        if not ext:
            return None
        length = int.from_bytes(ext, 'big')
    if length > MAX_WS_FRAME_BYTES:
        return None
    if header[1] & 0x80:
        mask = recv_exact(sock, 4)
        payload = recv_exact(sock, length)
        if not mask or payload is None:
            return None
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    else:
        payload = recv_exact(sock, length)
        if payload is None:
            return None
    return payload.decode('utf-8', errors='replace')

def send_cdp_eval(ws_url, expr, expected_port):
    try:
        u = urllib.parse.urlparse(ws_url)
        if (
            u.scheme != "ws"
            or u.hostname not in ("127.0.0.1", "localhost")
            or u.port != expected_port
            or not u.path.startswith("/devtools/")
        ):
            return False
        s = socket.create_connection(("127.0.0.1", expected_port), timeout=3)
        key = base64.b64encode(os.urandom(16)).decode('utf-8')
        req = (
            f"GET {u.path} HTTP/1.1\r\n"
            f"Host: 127.0.0.1:{expected_port}\r\n"
            f"Upgrade: websocket\r\n"
            f"Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n"
        )
        s.sendall(req.encode('utf-8'))
        res = s.recv(4096)
        if b"101" not in res:
            s.close()
            return False

        payload = json.dumps({
            "id": 1,
            "method": "Runtime.evaluate",
            "params": {"expression": expr, "returnByValue": True}
        }).encode('utf-8')

        length = len(payload)
        mask = os.urandom(4)
        header = bytearray([0x81])
        if length < 126:
            header.append(0x80 | length)
        elif length < 65536:
            header.append(0x80 | 126)
            header.extend(length.to_bytes(2, 'big'))
        else:
            header.append(0x80 | 127)
            header.extend(length.to_bytes(8, 'big'))

        masked = bytearray(b ^ mask[i % 4] for i, b in enumerate(payload))
        s.sendall(header + mask + masked)

        s.settimeout(2)
        ready = False
        try:
            reply_raw = read_ws_text_frame(s)
            if reply_raw:
                reply = json.loads(reply_raw)
                res_obj = reply.get("result", {})
                if (
                    "error" not in reply
                    and "exceptionDetails" not in res_obj
                    and res_obj.get("result", {}).get("value") is True
                ):
                    ready = True
        except Exception:
            pass
        s.close()
        return ready
    except Exception:
        return False

INJECTION_SCRIPT = """
(() => {
    window._malusButtonsRight = __BUTTONS_RIGHT__;

    function relocate() {
        const rightMode = Boolean(window._malusButtonsRight);
        const target = document.querySelector(rightMode ? '.titlebar-right' : '.titlebar-left');
        const controls = document.querySelector('.window-controls-container');
        if (target && controls) {
            if (rightMode) {
                if (controls.parentElement !== target || target.lastElementChild !== controls) {
                    target.append(controls);
                }
            } else {
                if (controls.parentElement !== target || target.firstElementChild !== controls) {
                    target.prepend(controls);
                }
            }
            return true;
        }
        return false;
    }

