#!/usr/bin/env bash
# ==============================================================================
# Malus DE Session Wrapper (GDM & TTY Wayland Session Launcher)
# ==============================================================================
set -euo pipefail

LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/malus-de"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/session.log"

# Redirigir toda la salida al archivo de registro para diagnóstico
exec > >(tee -a "$LOG_FILE") 2>&1

echo "============================================================"
echo "🍎 INICIANDO SESIÓN DE MALUS DE: $(date '+%Y-%m-%d %H:%M:%S')"
echo "============================================================"

# Localizar binarios: 1) Workspace release, 2) /usr/local/bin, 3) Workspace debug
PROJECT_DIR="$HOME/Apps/malus-de"

if [ -x "$PROJECT_DIR/target/release/malus-de-compositor" ]; then
    BIN_DIR="$PROJECT_DIR/target/release"
elif [ -x "/usr/local/bin/malus-de-compositor" ]; then
    BIN_DIR="/usr/local/bin"
elif [ -x "$PROJECT_DIR/target/debug/malus-de-compositor" ]; then
    BIN_DIR="$PROJECT_DIR/target/debug"
else
    echo "❌ Error: No se encontró malus-de-compositor instalado ni compilado."
    exit 1
fi
echo "📍 Utilizando binarios desde: $BIN_DIR"
export PATH="$BIN_DIR:$PATH"

# ------------------------------------------------------------------------------
# Configuración del entorno de sesión aislado (macOS UX sin afectar GNOME)
# ------------------------------------------------------------------------------
export XDG_CURRENT_DESKTOP="Malus:GNOME"
export XDG_SESSION_DESKTOP="malus"
export XDG_SESSION_TYPE="wayland"
export LIBSEAT_BACKEND="logind"

HOST_XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CONFIG_HOME="$HOME/.config/malus-de"
export GSETTINGS_BACKEND="keyfile"
export GTK_USE_PORTAL=1
export UBUNTU_MENUPROXY=1
export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module"
export GDK_BACKEND="wayland"
export GSK_RENDERER="cairo"
export QT_QPA_PLATFORM="wayland"
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
export MOZ_ENABLE_WAYLAND=1

# Asegurar archivos de configuración aislados de GNOME (respetando elecciones previas del usuario)
mkdir -p "$XDG_CONFIG_HOME/glib-2.0/settings" "$XDG_CONFIG_HOME/gtk-3.0" "$XDG_CONFIG_HOME/gtk-4.0"

# Mantener disponibles en Nautilus las carpetas especiales XDG del usuario.
USER_DIRS_FILE="$XDG_CONFIG_HOME/user-dirs.dirs"
HOST_USER_DIRS_FILE="$HOST_XDG_CONFIG_HOME/user-dirs.dirs"
if [ ! -f "$USER_DIRS_FILE" ] && [ -f "$HOST_USER_DIRS_FILE" ]; then
    cp "$HOST_USER_DIRS_FILE" "$USER_DIRS_FILE"
fi
touch "$USER_DIRS_FILE"

USER_DIR_PATHS=()

ensure_user_dir() {
    key="$1"
    default_dir="$2"
    path="$(sed -n "s/^${key}=\"\\(.*\\)\"$/\\1/p" "$USER_DIRS_FILE" | head -n 1)"
    if [ -z "$path" ]; then
        printf '%s="$HOME/%s"\n' "$key" "$default_dir" >> "$USER_DIRS_FILE"
        path="$HOME/$default_dir"
    else
        case "$path" in
            '$HOME/'*) path="$HOME/${path#\$HOME/}" ;;
            /*) ;;
            *) return 0 ;;
        esac
    fi
    mkdir -p "$path"
    USER_DIR_PATHS+=("$path")
}

ensure_user_dir XDG_DESKTOP_DIR Desktop
ensure_user_dir XDG_DOWNLOAD_DIR Downloads
ensure_user_dir XDG_TEMPLATES_DIR Templates
ensure_user_dir XDG_PUBLICSHARE_DIR Public
ensure_user_dir XDG_DOCUMENTS_DIR Documents
ensure_user_dir XDG_MUSIC_DIR Music
ensure_user_dir XDG_PICTURES_DIR Pictures
ensure_user_dir XDG_VIDEOS_DIR Videos

# Nautilus muestra las carpetas XDG en su propia sección, separada de los marcadores.
# Eliminar las entradas sin etiqueta que las versiones anteriores agregaban como marcadores.
python3 - "$XDG_CONFIG_HOME/gtk-3.0/bookmarks" "$XDG_CONFIG_HOME/gtk-4.0/bookmarks" "${USER_DIR_PATHS[@]}" <<'PY'
import os
import sys
from pathlib import Path

bookmark_files = sys.argv[1:3]
user_dir_uris = {
    Path(os.path.abspath(user_dir)).as_uri()
    for user_dir in sys.argv[3:]
}

for bookmark_file in bookmark_files:
    try:
        with open(bookmark_file, encoding="utf-8") as bookmarks:
            lines = bookmarks.readlines()
    except FileNotFoundError:
        continue

    filtered_lines = []
    for line in lines:
        parts = line.split(maxsplit=1)
        if len(parts) == 1 and parts[0] in user_dir_uris:
            continue
        filtered_lines.append(line)
    if filtered_lines != lines:
        with open(bookmark_file, "w", encoding="utf-8") as bookmarks:
            bookmarks.writelines(filtered_lines)
PY

if [ ! -f "$XDG_CONFIG_HOME/glib-2.0/settings/keyfile" ]; then
cat << 'EOF' > "$XDG_CONFIG_HOME/glib-2.0/settings/keyfile"
[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
cursor-theme='macOS'
cursor-size=24
gtk-theme='Adwaita'
icon-theme='Adwaita'

[org/gnome/settings-daemon/plugins/xsettings]
overrides={'Gtk/ShellShowsAppMenu': <1>, 'Gtk/ShellShowsMenubar': <1>}
EOF
fi

CURSOR_THEME="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | sed "s/^'//; s/'$//")" || CURSOR_THEME=""
CURSOR_SIZE="$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)" || CURSOR_SIZE=""
[ -n "$CURSOR_THEME" ] || CURSOR_THEME="macOS"
case "$CURSOR_SIZE" in
    ''|*[!0-9]*) CURSOR_SIZE=24 ;;
esac
export XCURSOR_THEME="$CURSOR_THEME"
export XCURSOR_SIZE="$CURSOR_SIZE"

if [ ! -f "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" ]; then
cat << EOF > "$XDG_CONFIG_HOME/gtk-3.0/settings.ini"
[Settings]
gtk-decoration-layout=close,minimize,maximize:
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-theme-name=Adwaita
EOF
fi

if [ ! -f "$XDG_CONFIG_HOME/gtk-4.0/settings.ini" ]; then
cat << EOF > "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"
[Settings]
gtk-decoration-layout=close,minimize,maximize:
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-theme-name=Adwaita
EOF
fi

for GTK_SETTINGS in "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"; do
    if ! grep -q '^gtk-icon-theme-name=' "$GTK_SETTINGS"; then
        printf '\ngtk-icon-theme-name=Adwaita\n' >> "$GTK_SETTINGS"
    fi
done

# Evitar que Nautilus reutilice la instancia de GNOME y su configuración anterior.
if [ -z "${MALUS_NESTED_DBUS:-}" ]; then
    if command -v dbus-run-session >/dev/null 2>&1; then
        export MALUS_NESTED_DBUS=1
        exec dbus-run-session -- "$0" "$@"
    else
        echo "⚠️ dbus-run-session no está disponible; Nautilus podría reutilizar la sesión de GNOME."
    fi
fi

# Sincronizar variables iniciales con el daemon de activación D-Bus
dbus-update-activation-environment --all 2>/dev/null || true

# ------------------------------------------------------------------------------
# Limpieza de procesos previos de sesiones anteriores
# ------------------------------------------------------------------------------
pkill -f malus-de-top-bar 2>/dev/null || true
pkill -f malus-de-dock 2>/dev/null || true
pkill -f malus-de-spotlight 2>/dev/null || true
pkill -f malus-de-wallpaper 2>/dev/null || true
pkill -f malus-de-notifications 2>/dev/null || true
pkill -f malus-de-link 2>/dev/null || true

# Limpiar sockets huérfanos previos para evitar que el bucle de espera detecte un socket muerto
python3 -c "
import os, glob, socket
uid = os.getuid()
for s in glob.glob(f'/run/user/{uid}/wayland-[0-9]*'):
    if not s.endswith('.lock'):
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(s)
            sock.close()
        except Exception:
            try:
                os.remove(s)
                lock = s + '.lock'
                if os.path.exists(lock):
                    os.remove(lock)
            except Exception:
                pass
" 2>/dev/null || true

# ------------------------------------------------------------------------------
# 1. Iniciar Compositor Wayland Smithay (DRM nativo o Winit anidado)
# ------------------------------------------------------------------------------
BACKEND_FLAG="--backend drm"
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
    echo "🖥️ Detectada sesión gráfica padre: ejecutando compositor en modo anidado (winit)"
    BACKEND_FLAG="--backend winit"
else
    echo "⚡ Sesión directa de hardware (GDM / TTY): ejecutando compositor en modo nativo DRM/KMS"
fi

"$BIN_DIR/malus-de-compositor" $BACKEND_FLAG &
COMPOSITOR_PID=$!
echo "🚀 Compositor iniciado con PID: $COMPOSITOR_PID"

# Esperar a que el socket Wayland esté disponible y respondiendo activamente a conexiones
SOCKET_FOUND=""
for i in {1..60}; do
    if [ ! -d "/proc/$COMPOSITOR_PID" ]; then
        echo "❌ Error: El compositor terminó inesperadamente."
        exit 1
    fi
    for s in /run/user/"$UID"/wayland-[0-9]*; do
        if [ -S "$s" ]; then
            if python3 -c "import socket; s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.connect('$s'); s.close()" 2>/dev/null; then
                SOCKET_FOUND="$(basename "$s")"
                break 2
            fi
        fi
    done
    sleep 0.1
done

if [ -n "$SOCKET_FOUND" ]; then
    export WAYLAND_DISPLAY="$SOCKET_FOUND"
    echo "✅ Socket Wayland detectado y activo: WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
else
    export WAYLAND_DISPLAY="wayland-1"
    echo "⚠️ Socket Wayland no detectado a tiempo, asumiendo WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
fi

# Actualizar el entorno de activación antes de iniciar los portales, para que
# hereden el socket del compositor de Malus y no el de la sesión de inicio.
dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GDK_BACKEND GSK_RENDERER XDG_CONFIG_HOME GSETTINGS_BACKEND GTK_USE_PORTAL XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE GDK_BACKEND GSK_RENDERER XDG_CONFIG_HOME GSETTINGS_BACKEND GTK_USE_PORTAL XCURSOR_THEME XCURSOR_SIZE || echo "⚠️ No se pudo importar el entorno de Malus a systemd --user."
    systemctl --user start malus-session.target || echo "⚠️ No se pudo iniciar malus-session.target."
    systemctl --user start xdg-desktop-portal || echo "⚠️ No se pudo iniciar xdg-desktop-portal."
fi

# ------------------------------------------------------------------------------
# 2. Iniciar Servicios y Componentes del Shell de Malus DE
# ------------------------------------------------------------------------------
echo "🎨 [1/5] Iniciando Fondo de Pantalla (malus-de-wallpaper)..."
"$BIN_DIR/malus-de-wallpaper" &
WALLPAPER_PID=$!

echo "🍏 [2/5] Iniciando Menú Global & Control Center (malus-de-top-bar)..."
"$BIN_DIR/malus-de-top-bar" &
TOPBAR_PID=$!

echo "🛳  [3/5] Iniciando Dock Flotante (malus-de-dock)..."
"$BIN_DIR/malus-de-dock" &
DOCK_PID=$!

echo "🔔 [4/5] Iniciando Servidor de Notificaciones D-Bus (malus-de-notifications)..."
"$BIN_DIR/malus-de-notifications" &
NOTIF_PID=$!

echo "📡 [5/5] Iniciando Malus Link & AirDrop (malus-de-link)..."
"$BIN_DIR/malus-de-link" &
LINK_PID=$!

echo "============================================================"
echo "✨ SESIÓN DE MALUS DE ACTIVA Y OPERATIVA"
echo "   PID del Compositor: $COMPOSITOR_PID"
echo "   Registro de sesión: $LOG_FILE"
echo "============================================================"

# Manejo de señales de cierre de sesión
cleanup() {
    echo ""
    echo "🛑 Finalizando sesión de Malus DE..."
    kill "$LINK_PID" 2>/dev/null || true
    kill "$NOTIF_PID" 2>/dev/null || true
    kill "$DOCK_PID" 2>/dev/null || true
    kill "$TOPBAR_PID" 2>/dev/null || true
    kill "$WALLPAPER_PID" 2>/dev/null || true
    kill "$COMPOSITOR_PID" 2>/dev/null || true
    echo "Sesión finalizada limpiamente: $(date '+%Y-%m-%d %H:%M:%S')"
}

trap cleanup EXIT INT TERM

wait "$COMPOSITOR_PID"
