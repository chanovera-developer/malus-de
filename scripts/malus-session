#!/usr/bin/env bash
# ==============================================================================
# Malus DE Session Wrapper (GDM & TTY Wayland Session Launcher)
# ==============================================================================
set -euo pipefail

# Si se ejecuta desde /usr/local/bin, delegar al script del repositorio si existe
SELF_REAL="$(readlink -f "$0" 2>/dev/null || echo "$0")"
for pdir in "${MALUS_DE_PROJECT_DIR:-}" "$HOME/Proyectos/malus-de" "$HOME/Apps/malus-de"; do
    if [ -n "$pdir" ] && [ -x "$pdir/scripts/malus-session" ]; then
        DEV_SCRIPT="$(readlink -f "$pdir/scripts/malus-session" 2>/dev/null || echo "$pdir/scripts/malus-session")"
        if [ "$SELF_REAL" != "$DEV_SCRIPT" ]; then
            exec "$DEV_SCRIPT" "$@"
        fi
        break
    fi
done

# En Fedora 45+ la consola usa kmscon (pts/N) y retiene el DRM master de la GPU.
# Si ejecutamos desde kmscon sin envolver todavía, delegar en kmscon-launch-gui
# ANTES de redirigir stdout a tee para que kmscon reciba el escape OSC y libere la GPU.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ] && [ -z "${MALUS_KMSCON_WRAPPED:-}" ]; then
    if command -v kmscon-launch-gui >/dev/null 2>&1 && [ -t 1 ]; then
        is_kmscon_pty=0
        case "${TERM:-}" in
            kmscon*) is_kmscon_pty=1 ;;
        esac
        if [ "$is_kmscon_pty" -eq 0 ] && [ -n "${XDG_VTNR:-}" ]; then
            case "$(tty 2>/dev/null || true)" in
                /dev/pts/*)
                    if pgrep -x kmscon >/dev/null 2>&1; then
                        is_kmscon_pty=1
                    fi
                    ;;
            esac
        fi
        if [ "$is_kmscon_pty" -eq 1 ]; then
            export MALUS_KMSCON_WRAPPED=1
            exec kmscon-launch-gui "$SELF_REAL" "$@"
        fi
    fi
fi

LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/malus-de"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/session.log"
CLEAN_EXIT_MARKER="$LOG_DIR/clean-exit"
rm -f "$CLEAN_EXIT_MARKER"

# Redirigir toda la salida al archivo de registro para diagnóstico
exec > >(tee -a "$LOG_FILE") 2>&1

echo "============================================================"
echo "🍎 INICIANDO SESIÓN DE MALUS DE: $(date '+%Y-%m-%d %H:%M:%S')"
echo "============================================================"

# Localizar binarios: checkout local, instalación del sistema y checkout debug.
# El launcher instalado no comparte necesariamente la ruta del checkout original.
PROJECT_DIRS=()
if [ -n "${MALUS_DE_PROJECT_DIR:-}" ]; then
    PROJECT_DIRS+=("$MALUS_DE_PROJECT_DIR")
fi
PROJECT_DIRS+=("$HOME/Proyectos/malus-de" "$HOME/Apps/malus-de")

BIN_DIR=""
for project_dir in "${PROJECT_DIRS[@]}"; do
    if [ -x "$project_dir/target/release/malus-de-compositor" ]; then
        BIN_DIR="$project_dir/target/release"
        break
    fi
done

if [ -z "$BIN_DIR" ] && [ -x "/usr/local/bin/malus-de-compositor" ]; then
    BIN_DIR="/usr/local/bin"
fi

if [ -z "$BIN_DIR" ]; then
    for project_dir in "${PROJECT_DIRS[@]}"; do
        if [ -x "$project_dir/target/debug/malus-de-compositor" ]; then
            BIN_DIR="$project_dir/target/debug"
            break
        fi
    done
fi

if [ -z "$BIN_DIR" ]; then
    echo "❌ Error: No se encontró malus-de-compositor instalado ni compilado."
    exit 1
fi
echo "📍 Utilizando binarios desde: $BIN_DIR"
export PATH="$BIN_DIR:$PATH"
export MALUS_DE_BIN_DIR="$BIN_DIR"

# ------------------------------------------------------------------------------
# Configuración del entorno de sesión aislado (macOS UX sin afectar GNOME)
# ------------------------------------------------------------------------------
export XDG_CURRENT_DESKTOP="Malus:GNOME"
export XDG_SESSION_DESKTOP="malus"
export XDG_SESSION_TYPE="wayland"
export LIBSEAT_BACKEND="logind"

HOST_XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CONFIG_HOME="$HOME/.config/malus-de"
export GSETTINGS_BACKEND="keyfile"
export FREETYPE_PROPERTIES="${FREETYPE_PROPERTIES:-truetype:interpreter-version=40 cff:no-stem-darkening=0 autofitter:no-stem-darkening=0}"
export UBUNTU_MENUPROXY=1
export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module"
export GDK_BACKEND="wayland"
export GSK_RENDERER="cairo"
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
export MOZ_ENABLE_WAYLAND=1

# Limpiar configuraciones que versiones anteriores pudieron haber filtrado al host GNOME
if [ -f "$HOST_XDG_CONFIG_HOME/gtk-3.0/settings.ini" ] && grep -q "close,minimize,maximize:" "$HOST_XDG_CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null; then
    rm -f "$HOST_XDG_CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null || true
fi
if [ -f "$HOST_XDG_CONFIG_HOME/gtk-4.0/settings.ini" ] && grep -q "close,minimize,maximize:" "$HOST_XDG_CONFIG_HOME/gtk-4.0/settings.ini" 2>/dev/null; then
    rm -f "$HOST_XDG_CONFIG_HOME/gtk-4.0/settings.ini" 2>/dev/null || true
fi

# Limpiar valores que versiones anteriores filtraron al entorno global de systemd.
unset GTK_USE_PORTAL 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment GTK_USE_PORTAL 2>/dev/null || true
fi

# Asegurar archivos de configuración aislados de GNOME (respetando elecciones previas del usuario)
mkdir -p "$XDG_CONFIG_HOME/glib-2.0/settings" "$XDG_CONFIG_HOME/gtk-3.0" "$XDG_CONFIG_HOME/gtk-4.0" "$XDG_CONFIG_HOME/xdg-desktop-portal"

cat << 'EOF' > "$XDG_CONFIG_HOME/xdg-desktop-portal/portals.conf"
[preferred]
default=gtk;
org.freedesktop.impl.portal.Settings=gtk;
org.freedesktop.impl.portal.Secret=gnome-keyring;
EOF
cp -f "$XDG_CONFIG_HOME/xdg-desktop-portal/portals.conf" "$XDG_CONFIG_HOME/xdg-desktop-portal/malus-portals.conf"
cp -f "$XDG_CONFIG_HOME/xdg-desktop-portal/portals.conf" "$XDG_CONFIG_HOME/xdg-desktop-portal/Malus-portals.conf"

# Mantener disponible el tema declarativo instalado para componentes que lo consuman.
if [ ! -d "$XDG_CONFIG_HOME/themes/default-dark" ] \
    && [ -d "/usr/local/share/malus-de/themes/default-dark" ]; then
    mkdir -p "$XDG_CONFIG_HOME/themes"
    cp -R "/usr/local/share/malus-de/themes/default-dark" "$XDG_CONFIG_HOME/themes/"
fi

# Mantener disponibles en Nautilus las carpetas especiales XDG del usuario.
USER_DIRS_FILE="$XDG_CONFIG_HOME/user-dirs.dirs"
HOST_USER_DIRS_FILE="$HOST_XDG_CONFIG_HOME/user-dirs.dirs"
if [ ! -f "$USER_DIRS_FILE" ] && [ -f "$HOST_USER_DIRS_FILE" ]; then
    cp "$HOST_USER_DIRS_FILE" "$USER_DIRS_FILE"
fi
touch "$USER_DIRS_FILE"

USER_DIR_PATHS=()

ensure_user_dir() {
    key="$1"
    default_dir="$2"
    path="$(sed -n "s/^${key}=\"\\(.*\\)\"$/\\1/p" "$USER_DIRS_FILE" | head -n 1)"
    if [ -z "$path" ]; then
        printf '%s="$HOME/%s"\n' "$key" "$default_dir" >> "$USER_DIRS_FILE"
        path="$HOME/$default_dir"
    else
        case "$path" in
            '$HOME/'*) path="$HOME/${path#\$HOME/}" ;;
            /*) ;;
            *) return 0 ;;
        esac
    fi
    mkdir -p "$path"
    USER_DIR_PATHS+=("$path")
}

ensure_user_dir XDG_DESKTOP_DIR Escritorio
ensure_user_dir XDG_DOWNLOAD_DIR Downloads
ensure_user_dir XDG_TEMPLATES_DIR Templates
ensure_user_dir XDG_PUBLICSHARE_DIR Public
ensure_user_dir XDG_DOCUMENTS_DIR Documents
ensure_user_dir XDG_MUSIC_DIR Music
ensure_user_dir XDG_PICTURES_DIR Pictures
ensure_user_dir XDG_VIDEOS_DIR Videos

# TODO: Revisar por qué Nautilus no muestra sus ubicaciones nativas en la sidebar,
# más allá de los marcadores importados o añadidos aquí.
# Nautilus separa los marcadores de sus ubicaciones nativas; mantener las carpetas XDG visibles allí.
if [ ! -f "$XDG_CONFIG_HOME/gtk-3.0/.gnome-bookmarks-imported" ] \
    || [ ! -f "$XDG_CONFIG_HOME/gtk-3.0/bookmarks" ] \
    || [ ! -f "$XDG_CONFIG_HOME/gtk-4.0/bookmarks" ]; then
python3 - "$XDG_CONFIG_HOME/gtk-3.0/bookmarks" "$XDG_CONFIG_HOME/gtk-4.0/bookmarks" \
    "$HOST_XDG_CONFIG_HOME/gtk-3.0/bookmarks" "$XDG_CONFIG_HOME/gtk-3.0/.gnome-bookmarks-imported" \
    "${USER_DIR_PATHS[@]}" <<'PY'
import os
import sys
from pathlib import Path

bookmark_files = sys.argv[1:3]
host_bookmark_file = Path(sys.argv[3])
import_marker = Path(sys.argv[4])
user_dirs = {
    Path(os.path.abspath(user_dir)).as_uri(): Path(user_dir).name
    for user_dir in sys.argv[5:]
}

try:
    host_lines = host_bookmark_file.read_text(encoding="utf-8").splitlines()
except FileNotFoundError:
    host_lines = None
import_host_bookmarks = not import_marker.exists() and host_lines is not None

for bookmark_file in bookmark_files:
    path = Path(bookmark_file)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        lines = []

    needs_write = False
    if import_host_bookmarks:
        existing_uris = {line.split(maxsplit=1)[0] for line in lines if line.split(maxsplit=1)}
        for line in host_lines:
            parts = line.split(maxsplit=1)
            if parts and parts[0] not in existing_uris:
                lines.append(line)
                existing_uris.add(parts[0])
                needs_write = True

    updated_lines = []
    seen_user_dirs = set()
    for line in lines:
        parts = line.split(maxsplit=1)
        uri = parts[0] if parts else ""
        if uri in user_dirs:
            if uri in seen_user_dirs:
                continue
            seen_user_dirs.add(uri)
            if len(parts) == 1:
                line = f"{uri} {user_dirs[uri]}"
        updated_lines.append(line)

    for uri, label in user_dirs.items():
        if uri not in seen_user_dirs:
            updated_lines.append(f"{uri} {label}")

    if needs_write or updated_lines != lines:
        path.write_text("\n".join(updated_lines) + "\n", encoding="utf-8")

if import_host_bookmarks:
    import_marker.touch()
PY
fi

MALUS_BUTTON_LAYOUT="close,minimize,maximize:"
if grep -Eq '^[[:space:]]*window_buttons_right[[:space:]]*=[[:space:]]*true' "$XDG_CONFIG_HOME/appearance-settings.toml" 2>/dev/null; then
    MALUS_BUTTON_LAYOUT=":minimize,maximize,close"
fi

KEYFILE_PATH="$XDG_CONFIG_HOME/glib-2.0/settings/keyfile"
if [ ! -f "$KEYFILE_PATH" ]; then
cat << EOF > "$KEYFILE_PATH"
[org/gnome/desktop/wm/preferences]
button-layout='$MALUS_BUTTON_LAYOUT'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
cursor-theme='macOS'
cursor-size=24
document-font-name='Inter 11'
font-antialiasing='grayscale'
font-hinting='slight'
font-name='Inter 11'
font-rendering='manual'
font-rgba-order='rgb'
gtk-theme='Adwaita'
icon-theme='Malus'

[org/gnome/desktop/media-handling]
automount=true
automount-open=false

[org/gnome/settings-daemon/plugins/xsettings]
overrides={'Gtk/ShellShowsAppMenu': <1>, 'Gtk/ShellShowsMenubar': <1>}
EOF
fi

# Aplicar y asegurar el diseño configurado de botones en el keyfile aislado de Malus DE solo si falta o difiere
if ! grep -q "^button-layout='$MALUS_BUTTON_LAYOUT'" "$KEYFILE_PATH" 2>/dev/null; then
    gsettings set org.gnome.desktop.wm.preferences button-layout "$MALUS_BUTTON_LAYOUT" || true
fi

# Nautilus usa esta configuración aislada para montar medios extraíbles.
if ! grep -q "^automount=true$" "$KEYFILE_PATH" 2>/dev/null; then
    if ! gsettings set org.gnome.desktop.media-handling automount true; then
        echo "No se pudo activar el automontaje de medios en la configuración de Malus DE." >&2
        exit 1
    fi
fi
if ! grep -q "^automount-open=false$" "$KEYFILE_PATH" 2>/dev/null; then
    if ! gsettings set org.gnome.desktop.media-handling automount-open false; then
        echo "No se pudo desactivar la apertura automática de ventanas para medios montados." >&2
        exit 1
    fi
fi

# Sincronizar temas de iconos en segundo plano solo si faltan o cambiaron (sin bloquear el login)
sync_bundled_icons_bg() {
    mkdir -p "$HOME/.local/share/icons"
    local icon_src_base=""
    for candidate in "${PROJECT_DIRS[@]/%//assets/icons}" "/usr/local/share/malus-de/icons"; do
        if [ -f "$candidate/Malus/index.theme" ]; then
            icon_src_base="$candidate"
            break
        fi
    done
    [ -z "$icon_src_base" ] && return 0

    for icon_theme in "Colloid-Light" "Colloid-Dark" "Malus" "Malus-Dark"; do
        local src_dir="$icon_src_base/$icon_theme"
        local dst_dir="$HOME/.local/share/icons/$icon_theme"
        [ -f "$src_dir/index.theme" ] || continue

        local stamp_file="$dst_dir/.malus-sync-stamp"
        local src_stamp
        src_stamp="$(stat -c '%Y:%n' "$src_dir" "$src_dir/index.theme" 2>/dev/null | tr '\n' '|')"
        local needs_sync=0
        if [ ! -f "$dst_dir/index.theme" ]; then
            needs_sync=1
        elif [ "$icon_theme" = "Malus" ] || [ "$icon_theme" = "Malus-Dark" ]; then
            if [ ! -f "$stamp_file" ] || [ "$(cat "$stamp_file" 2>/dev/null || true)" != "$src_stamp" ]; then
                needs_sync=1
            fi
        fi

        if [ "$needs_sync" -eq 1 ]; then
            rm -rf "$dst_dir"
            cp -a "$src_dir" "$HOME/.local/share/icons/" 2>/dev/null || true
            printf '%s\n' "$src_stamp" > "$stamp_file" 2>/dev/null || true
            if command -v gtk-update-icon-cache >/dev/null 2>&1; then
                gtk-update-icon-cache -f -t "$dst_dir" 2>/dev/null || true
            fi
        fi
    done
}
sync_bundled_icons_bg &

# Asegurar que el tema de cursores macOS integrado en el proyecto esté instalado en el entorno del usuario
mkdir -p "$HOME/.local/share/icons" "$HOME/.icons"
for cursor_src_base in "${PROJECT_DIRS[@]/%//assets/cursors}" "/usr/local/share/malus-de/cursors"; do
    if [ -d "$cursor_src_base/macOS/cursors" ]; then
        for variant in "macOS" "macOS-White"; do
            if [ -d "$cursor_src_base/$variant/cursors" ]; then
                for target_root in "$HOME/.local/share/icons" "$HOME/.icons"; do
                    if [ ! -d "$target_root/$variant/cursors" ]; then
                        cp -Rf "$cursor_src_base/$variant" "$target_root/" 2>/dev/null || true
                    elif [ "$cursor_src_base/$variant/index.theme" -nt "$target_root/$variant/index.theme" ]; then
                        cp -f "$cursor_src_base/$variant/index.theme" "$cursor_src_base/$variant/cursor.theme" "$target_root/$variant/" 2>/dev/null || true
                    fi
                done
            fi
        done
        break
    fi
done

CURSOR_THEME="$(sed -n "s/^cursor-theme='\([^']*\)'$/\1/p" "$KEYFILE_PATH" 2>/dev/null | head -n 1)"
CURSOR_SIZE="$(sed -n "s/^cursor-size=\([0-9][0-9]*\)$/\1/p" "$KEYFILE_PATH" 2>/dev/null | head -n 1)"
if [ -z "$CURSOR_THEME" ]; then
    CURSOR_THEME="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | sed "s/^'//; s/'$//")" || CURSOR_THEME=""
fi
if [ -z "$CURSOR_SIZE" ]; then
    CURSOR_SIZE="$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)" || CURSOR_SIZE=""
fi
if [ -z "$CURSOR_THEME" ] || [ "$CURSOR_THEME" = "Adwaita" ] || [ "$CURSOR_THEME" = "default" ]; then
    CURSOR_THEME="macOS"
    gsettings set org.gnome.desktop.interface cursor-theme "macOS" 2>/dev/null || true
fi
if [ ! -d "$HOME/.icons/$CURSOR_THEME/cursors" ] \
    && [ ! -d "$HOME/.local/share/icons/$CURSOR_THEME/cursors" ] \
    && [ ! -d "/usr/local/share/malus-de/cursors/$CURSOR_THEME/cursors" ] \
    && [ ! -d "/usr/share/icons/$CURSOR_THEME/cursors" ]; then
    CURSOR_THEME="macOS"
    gsettings set org.gnome.desktop.interface cursor-theme "macOS" 2>/dev/null || true
fi
case "$CURSOR_SIZE" in
    ''|*[!0-9]*) CURSOR_SIZE=24 ;;
esac
export XCURSOR_PATH="$HOME/.local/share/icons:$HOME/.icons:/usr/local/share/malus-de/cursors:/usr/share/icons${XCURSOR_PATH:+:$XCURSOR_PATH}"
export XCURSOR_THEME="$CURSOR_THEME"
export XCURSOR_SIZE="$CURSOR_SIZE"

if [ ! -f "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" ]; then
cat << EOF > "$XDG_CONFIG_HOME/gtk-3.0/settings.ini"
[Settings]
gtk-decoration-layout=$MALUS_BUTTON_LAYOUT
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-font-name=Inter 11
gtk-theme-name=Adwaita
EOF
else
    sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$CURSOR_THEME/" "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null || true
    sed -i "s/^gtk-decoration-layout=.*/gtk-decoration-layout=$MALUS_BUTTON_LAYOUT/" "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null || true
fi

if [ ! -f "$XDG_CONFIG_HOME/gtk-4.0/settings.ini" ]; then
cat << EOF > "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"
[Settings]
gtk-decoration-layout=$MALUS_BUTTON_LAYOUT
gtk-application-prefer-dark-theme=0
gtk-cursor-theme-name=$CURSOR_THEME
gtk-cursor-theme-size=$CURSOR_SIZE
gtk-font-name=Inter 11
gtk-theme-name=Adwaita
EOF
else
    sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$CURSOR_THEME/" "$XDG_CONFIG_HOME/gtk-4.0/settings.ini" 2>/dev/null || true
    sed -i "s/^gtk-decoration-layout=.*/gtk-decoration-layout=$MALUS_BUTTON_LAYOUT/" "$XDG_CONFIG_HOME/gtk-4.0/settings.ini" 2>/dev/null || true
fi

DEFAULT_GTK_ICON_THEME="Malus"
if grep -q "color-scheme='prefer-dark'" "$XDG_CONFIG_HOME/glib-2.0/settings/keyfile" 2>/dev/null; then
    DEFAULT_GTK_ICON_THEME="Malus-Dark"
fi

for GTK_SETTINGS in "$XDG_CONFIG_HOME/gtk-3.0/settings.ini" "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"; do
    if ! grep -q '^gtk-icon-theme-name=' "$GTK_SETTINGS"; then
        printf '\ngtk-icon-theme-name=%s\n' "$DEFAULT_GTK_ICON_THEME" >> "$GTK_SETTINGS"
    else
        sed -i "s/^gtk-icon-theme-name=Adwaita$/gtk-icon-theme-name=$DEFAULT_GTK_ICON_THEME/" "$GTK_SETTINGS" 2>/dev/null || true
    fi
    if ! grep -q '^gtk-font-name=' "$GTK_SETTINGS"; then
        printf 'gtk-font-name=Inter 11\n' >> "$GTK_SETTINGS"
    fi
    for xft_kv in \
        "gtk-xft-antialias=1" \
        "gtk-xft-hinting=1" \
        "gtk-xft-hintstyle=hintslight" \
        "gtk-xft-rgba=none"; do
        xft_key="${xft_kv%%=*}"
        if ! grep -q "^${xft_key}=" "$GTK_SETTINGS"; then
            printf '%s\n' "$xft_kv" >> "$GTK_SETTINGS"
        fi
    done
    if [[ "$GTK_SETTINGS" == *"/gtk-4.0/"* ]]; then
        if ! grep -q "^gtk-hint-font-metrics=" "$GTK_SETTINGS"; then
            printf 'gtk-hint-font-metrics=1\n' >> "$GTK_SETTINGS"
        fi
    else
        sed -i '/^gtk-hint-font-metrics=/d' "$GTK_SETTINGS" 2>/dev/null || true
    fi
    sed -i '/^[[:space:]]*1[[:space:]]*$/d' "$GTK_SETTINGS" 2>/dev/null || true
done

mkdir -p "$XDG_CONFIG_HOME/fontconfig/conf.d"
if [ ! -f "$XDG_CONFIG_HOME/fontconfig/conf.d/10-malus-inter.conf" ] \
    || ! grep -q 'hintslight' "$XDG_CONFIG_HOME/fontconfig/conf.d/10-malus-inter.conf" 2>/dev/null; then
cat << 'EOF' > "$XDG_CONFIG_HOME/fontconfig/conf.d/10-malus-inter.conf"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- Fuente predeterminada del entorno Malus DE: Inter -->
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>Inter</family>
    </prefer>
  </alias>
  <alias>
    <family>sans</family>
    <prefer>
      <family>Inter</family>
    </prefer>
  </alias>
  <alias>
    <family>system-ui</family>
    <prefer>
      <family>Inter</family>
    </prefer>
  </alias>

  <!-- Renderizado estilo macOS: suavizado en escala de grises sin fringing RGB,
       hinting vertical ligero (autofitter con stem darkening) y métricas horizontales puras -->
  <match target="font">
    <edit name="antialias" mode="assign">
      <bool>true</bool>
    </edit>
    <edit name="hinting" mode="assign">
      <bool>true</bool>
    </edit>
    <edit name="hintstyle" mode="assign">
      <const>hintslight</const>
    </edit>
    <edit name="autohint" mode="assign">
      <bool>true</bool>
    </edit>
    <edit name="rgba" mode="assign">
      <const>none</const>
    </edit>
    <edit name="lcdfilter" mode="assign">
      <const>lcddefault</const>
    </edit>
    <edit name="embeddedbitmap" mode="assign">
      <bool>false</bool>
    </edit>
  </match>
</fontconfig>
EOF
fi

# ------------------------------------------------------------------------------
# Limpieza de procesos previos de sesiones anteriores
# ------------------------------------------------------------------------------
pkill -f malus-de-top-bar 2>/dev/null || true
pkill -f malus-de-dock 2>/dev/null || true
pkill -f malus-de-spotlight 2>/dev/null || true
pkill -f malus-de-wallpaper 2>/dev/null || true
pkill -f malus-de-notifications 2>/dev/null || true
pkill -f malus-de-link 2>/dev/null || true

# ------------------------------------------------------------------------------
# 1. Iniciar Compositor Wayland Smithay (DRM nativo o Winit anidado)
#    (malus-de-compositor limpia automáticamente sockets Wayland huérfanos en Rust)
# ------------------------------------------------------------------------------
BACKEND_FLAG="--backend drm"
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
    echo "🖥️ Detectada sesión gráfica padre: ejecutando compositor en modo anidado (winit)"
    BACKEND_FLAG="--backend winit"
else
    echo "⚡ Sesión directa de hardware (GDM / TTY): ejecutando compositor en modo nativo DRM/KMS"
fi

"$BIN_DIR/malus-de-compositor" $BACKEND_FLAG &
COMPOSITOR_PID=$!
echo "🚀 Compositor iniciado con PID: $COMPOSITOR_PID"

# Esperar en un único proceso ligero (sondeo cada 15ms) a que el socket Wayland acepte conexiones
SOCKET_FOUND="$(python3 - "$COMPOSITOR_PID" "$UID" <<'PY' 2>/dev/null || true
import glob, os, socket, sys, time
comp_pid = sys.argv[1]
uid = sys.argv[2]
deadline = time.monotonic() + 6.0
while time.monotonic() < deadline:
    if not os.path.isdir(f"/proc/{comp_pid}"):
        sys.exit(2)
    for s in sorted(glob.glob(f"/run/user/{uid}/wayland-[0-9]*")):
        if s.endswith(".lock"):
            continue
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(s)
            sock.close()
            print(os.path.basename(s))
            sys.exit(0)
        except Exception:
            try:
                sock.close()
            except Exception:
                pass
    time.sleep(0.015)
PY
)"
if [ ! -d "/proc/$COMPOSITOR_PID" ]; then
    echo "❌ Error: El compositor terminó inesperadamente."
    exit 1
fi

if [ -n "$SOCKET_FOUND" ]; then
    export WAYLAND_DISPLAY="$SOCKET_FOUND"
    echo "✅ Socket Wayland detectado y activo: WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
else
    export WAYLAND_DISPLAY="wayland-1"
    echo "⚠️ Socket Wayland no detectado a tiempo, asumiendo WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
fi

# Propagar el entorno Wayland y la configuración aislada antes de levantar el Shell
dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GDK_BACKEND GSK_RENDERER QT_QPA_PLATFORM XCURSOR_THEME XCURSOR_SIZE XDG_CONFIG_HOME GSETTINGS_BACKEND 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE GDK_BACKEND GSK_RENDERER QT_QPA_PLATFORM XCURSOR_THEME XCURSOR_SIZE XDG_CONFIG_HOME GSETTINGS_BACKEND || echo "⚠️ No se pudo importar el entorno de Malus a systemd --user."
    systemctl --user start malus-session.target || echo "⚠️ No se pudo iniciar malus-session.target."
fi
export MALUS_ISOLATED_ENV_READY=1
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    : > "$XDG_RUNTIME_DIR/malus-isolated-env-ready" 2>/dev/null || true
fi

# ------------------------------------------------------------------------------
# 2. Iniciar Servicios y Componentes del Shell de Malus DE inmediatamente
# ------------------------------------------------------------------------------
echo "🎨 [1/5] Iniciando Fondo de Pantalla (malus-de-wallpaper)..."
(
    while kill -0 "$COMPOSITOR_PID" 2>/dev/null; do
        "$BIN_DIR/malus-de-wallpaper"
        EXIT_CODE=$?
        if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
            break
        fi
        echo "⚠️ malus-de-wallpaper terminó (código $EXIT_CODE); relanzando en 0.5s..."
        sleep 0.5
    done
) &
WALLPAPER_PID=$!

echo "🍏 [2/5] Iniciando Menú Global & Control Center (malus-de-top-bar)..."
"$BIN_DIR/malus-de-top-bar" &
TOPBAR_PID=$!

echo "🛳  [3/5] Iniciando Dock Flotante (malus-de-dock)..."
"$BIN_DIR/malus-de-dock" &
DOCK_PID=$!

echo "🔔 [4/5] Iniciando Servidor de Notificaciones D-Bus (malus-de-notifications)..."
(
    while kill -0 "$COMPOSITOR_PID" 2>/dev/null; do
        "$BIN_DIR/malus-de-notifications"
        EXIT_CODE=$?
        if ! kill -0 "$COMPOSITOR_PID" 2>/dev/null; then
            break
        fi
        echo "⚠️ malus-de-notifications terminó (código $EXIT_CODE); relanzando en 0.5s..."
        sleep 0.5
    done
) &
NOTIF_PID=$!

echo "📡 [5/5] Iniciando Malus Link & AirDrop (malus-de-link)..."
"$BIN_DIR/malus-de-link" &
LINK_PID=$!

# ------------------------------------------------------------------------------
# 3. Servicios auxiliares en paralelo (XWayland, Keyring, Polkit y Portales XDG)
#    para no retrasar la aparición visual del escritorio Wayland nativo.
# ------------------------------------------------------------------------------
XWAYLAND_PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/malus-xwayland-$$.pid"
POLKIT_PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/malus-polkit-$$.pid"
(
    if command -v Xwayland >/dev/null 2>&1; then
        XWAYLAND_DISPLAY_FILE="$(mktemp -t malus-xwayland-XXXXXX)"
        Xwayland -rootless -displayfd 3 3>"$XWAYLAND_DISPLAY_FILE" 2>/dev/null &
        XW_PID=$!
        printf '%s\n' "$XW_PID" > "$XWAYLAND_PID_FILE" 2>/dev/null || true
        for _ in $(seq 1 100); do
            if [ -s "$XWAYLAND_DISPLAY_FILE" ]; then
                X11_NUM="$(tr -d '\n\r' < "$XWAYLAND_DISPLAY_FILE")"
                export DISPLAY=":$X11_NUM"
                echo "✅ Servidor XWayland activo en DISPLAY=$DISPLAY (PID: $XW_PID)"
                break
            fi
            sleep 0.03
        done
        rm -f "$XWAYLAND_DISPLAY_FILE"
    fi

    if command -v gnome-keyring-daemon >/dev/null 2>&1; then
        echo "🔐 Inicializando llavero del sistema (gnome-keyring-daemon)..."
        if [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/keyring/control" ]; then
            systemctl --user start gnome-keyring-daemon.socket 2>/dev/null || true
        fi
        eval "$(gnome-keyring-daemon --start --daemonize --components=secrets,pkcs11,ssh 2>/dev/null)" || true
        export SSH_AUTH_SOCK
    fi

    for agent_bin in \
        "/usr/libexec/polkit-mate-authentication-agent-1" \
        "/usr/libexec/polkit-gnome-authentication-agent-1" \
        "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" \
        "/usr/libexec/xfce-polkit" \
        "/usr/bin/lxpolkit"; do
        if [ -x "$agent_bin" ]; then
            echo "🛡️ Iniciando agente de autenticación Polkit ($agent_bin)..."
            "$agent_bin" &
            printf '%s\n' "$!" > "$POLKIT_PID_FILE" 2>/dev/null || true
            break
        fi
    done

    dbus-update-activation-environment DISPLAY SSH_AUTH_SOCK 2>/dev/null || true
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user import-environment DISPLAY SSH_AUTH_SOCK 2>/dev/null || true
        systemctl --user restart xdg-desktop-portal-gtk xdg-desktop-portal 2>/dev/null || true
    fi
) &

echo "============================================================"
echo "✨ SESIÓN DE MALUS DE ACTIVA Y OPERATIVA"
echo "   PID del Compositor: $COMPOSITOR_PID"
echo "   Registro de sesión: $LOG_FILE"
echo "============================================================"

CRASH_DIR="$LOG_DIR/crashes"
mkdir -p "$CRASH_DIR"

launch_crash_reporter_pending() {
    if ! ls "$CRASH_DIR"/pending-*.txt >/dev/null 2>&1; then
        return 0
    fi
    if [ -x "$BIN_DIR/malus-de-crash-reporter" ]; then
        (sleep 1.2 && "$BIN_DIR/malus-de-crash-reporter" --pending >/dev/null 2>&1) &
    elif command -v malus-de-crash-reporter >/dev/null 2>&1; then
        (sleep 1.2 && malus-de-crash-reporter --pending >/dev/null 2>&1) &
    fi
}

# Si la sesión anterior dejó un reporte de fallo pendiente, abrir el diálogo ahora que el entorno está listo
launch_crash_reporter_pending

write_native_crash_dump() {
    local exit_code="$1"
    # Si el hook de panics de Rust ya creó un reporte del compositor en los últimos 15s, no duplicar
    if find "$CRASH_DIR" -maxdepth 1 -name 'pending-*-malus_de_compositor.txt' -newermt '-15 seconds' 2>/dev/null | grep -q .; then
        return 0
    fi

    local sig_label="código $exit_code"
    case "$exit_code" in
        132) sig_label="132 (SIGILL)" ;;
        134) sig_label="134 (SIGABRT)" ;;
        136) sig_label="136 (SIGFPE)" ;;
        137) sig_label="137 (SIGKILL)" ;;
        139) sig_label="139 (SIGSEGV)" ;;
        101) sig_label="101 (Panic de Rust)" ;;
    esac

    local stamp
    stamp="$(date -u '+%s')"
    local out_file="$CRASH_DIR/pending-${stamp}-malus_de_compositor.txt"
    local utc_now distro kernel_info git_rev coredump_info log_tail
    utc_now="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    distro="$(awk -F= '/^PRETTY_NAME=/{gsub(/"/,"",$2); print $2; exit}' /etc/os-release 2>/dev/null || echo 'Linux')"
    kernel_info="$(uname -srmo 2>/dev/null || echo 'desconocido')"
    git_rev="desconocido"
    for pdir in "${PROJECT_DIRS[@]}"; do
        if [ -d "$pdir/.git" ] && command -v git >/dev/null 2>&1; then
            git_rev="$(git -C "$pdir" log -1 --oneline 2>/dev/null || echo 'desconocido')"
            break
        fi
    done

    coredump_info="(coredumpctl no disponible o sin volcado reciente)"
    if command -v coredumpctl >/dev/null 2>&1; then
        coredump_info="$(coredumpctl info -1 --no-pager 2>/dev/null | head -n 60 || true)"
        [ -z "$coredump_info" ] && coredump_info="(sin volcado en coredumpctl)"
    fi

    log_tail="$(tail -n 150 "$LOG_FILE" 2>/dev/null || echo '(session.log no disponible)')"

    {
        echo "============================================================"
        echo "MALUS DE - INFORME DE FALLO (CRASH DUMP)"
        echo "============================================================"
        echo "Fecha (UTC):   $utc_now"
        echo "Componente:    malus-de-compositor"
        echo "Señal / Código:$sig_label"
        echo "Backend:       $BACKEND_FLAG"
        echo "Distro:        $distro"
        echo "Kernel:        $kernel_info"
        echo "Commit repo:   $git_rev"
        echo ""
        echo "--- MENSAJE DEL ERROR ---"
        echo "El compositor finalizó inesperadamente con $sig_label."
        echo ""
        echo "--- COREDUMP (coredumpctl info -1) ---"
        echo "$coredump_info"
        echo ""
        echo "--- ÚLTIMAS LÍNEAS DE session.log ---"
        echo "$log_tail"
    } | sed "s|$HOME|~|g" > "$out_file"
}

SESSION_INTERRUPTED=0
on_signal() {
    SESSION_INTERRUPTED=1
    cleanup
}

# Manejo de señales de cierre de sesión
cleanup() {
    echo ""
    echo "🛑 Finalizando sesión de Malus DE..."
    # Limpiar las variables aisladas en systemd para que una sesión posterior de GNOME no las herede
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user unset-environment XDG_CONFIG_HOME GSETTINGS_BACKEND GTK_USE_PORTAL 2>/dev/null || true
    fi
    if [ -n "${POLKIT_PID_FILE:-}" ] && [ -f "$POLKIT_PID_FILE" ]; then
        kill "$(cat "$POLKIT_PID_FILE" 2>/dev/null || true)" 2>/dev/null || true
        rm -f "$POLKIT_PID_FILE" 2>/dev/null || true
    fi
    if [ -n "${XWAYLAND_PID_FILE:-}" ] && [ -f "$XWAYLAND_PID_FILE" ]; then
        kill "$(cat "$XWAYLAND_PID_FILE" 2>/dev/null || true)" 2>/dev/null || true
        rm -f "$XWAYLAND_PID_FILE" 2>/dev/null || true
    fi
    kill "$LINK_PID" 2>/dev/null || true
    kill "$NOTIF_PID" 2>/dev/null || true
    kill "$DOCK_PID" 2>/dev/null || true
    kill "$TOPBAR_PID" 2>/dev/null || true
    kill "$WALLPAPER_PID" 2>/dev/null || true
    kill "$COMPOSITOR_PID" 2>/dev/null || true
    echo "Sesión finalizada limpiamente: $(date '+%Y-%m-%d %H:%M:%S')"
}

trap cleanup EXIT
trap on_signal INT TERM

COMP_EXIT=0
wait "$COMPOSITOR_PID" || COMP_EXIT=$?

IS_CLEAN_SIGNAL=0
case "$COMP_EXIT" in
    0|129|130|143) IS_CLEAN_SIGNAL=1 ;;
esac

if [ "$IS_CLEAN_SIGNAL" -eq 0 ] && [ "$SESSION_INTERRUPTED" -eq 0 ] && [ ! -f "$CLEAN_EXIT_MARKER" ]; then
    echo "💥 Compositor terminó con error ($COMP_EXIT); generando volcado de fallo..."
    write_native_crash_dump "$COMP_EXIT"
    if [ "$BACKEND_FLAG" = "--backend winit" ]; then
        launch_crash_reporter_pending
    fi
fi
rm -f "$CLEAN_EXIT_MARKER"
